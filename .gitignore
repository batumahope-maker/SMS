# ============================================================
# ESSJT School Management System
# Commit source only. Never secrets, databases, dumps, private
# uploads, exports, logs or build output.
# Rules are anchored with a leading "/" unless they must apply
# at every depth.
# ============================================================

# ---------- 1. Credential-bearing PHP ----------
# Root-relative: does NOT match admin/config.php and does NOT
# match src/lib/db.ts.
/config.php

# TEMPORARY: admin/config.php still holds the DB credentials.
# Delete this line in commit 2, after the split to the ignored
# admin/config.local.php lands.
/admin/config.php

# Orphaned connection files. Each contains a credential
# assignment and no PHP file in the tree requires or includes
# them (verified). Kept on disk; excluded from Git.
/db.php
/admin/db.php

# One-off migration script with a live external credential.
/MIGRATE-DATA.php
/config-supabase.php
/config-localphp
/SUPABASE-CREDENTIALS.txt

# ---------- 2. Local overrides created by the config split ----------
/config.local.php
/admin/config.local.php
*.local.php

# ---------- 3. Environment files ----------
# Negations MUST stay after ".env.*".
.env
.env.*
!.env.example
!.env.mysql.example
*.pem
*.key
*.pfx
*.p12
id_rsa*

