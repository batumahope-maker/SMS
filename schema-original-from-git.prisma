// ESSJT School Management System - Complete Database Schema
// Multi-tenant SaaS School Management System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// SCHOOL & LICENSING
// ============================================

model School {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  logo          String?
  address       String?
  phone         String?
  email         String?
  website       String?
  motto         String?
  primaryColor  String   @default("#667eea")
  secondaryColor String  @default("#764ba2")
  licenseKey    String?
  licenseStatus String   @default("trial") // trial, active, expired
  licenseExpiry DateTime?
  plan          String   @default("basic") // basic, standard, premium
  systemType    String   @default("tvet") // tvet, reb, both
  language      String   @default("en") // en, fr, rw
  timezone      String   @default("Africa/Kigali")
  academicYear  String   @default("2026")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  users         User[]
  students      Student[]
  teachers      Teacher[]
  parents       Parent[]
  classes       Class[]
  subjects      Subject[]
  announcements Announcement[]
  events        Event[]
  feeStructures FeeStructure[]
  payments      Payment[]
  expenses      Expense[]
  books         Book[]
  vehicles      Vehicle[]
  rooms         Room[]
  settings      Setting[]
  activityLogs  ActivityLog[]
  license       License?
}

model License {
  id          String   @id @default(cuid())
  key         String   @unique
  schoolId    String?  @unique
  school      School?  @relation(fields: [schoolId], references: [id])
  plan        String   @default("basic")
  features    String   // JSON string of features
  maxStudents Int      @default(500)
  maxTeachers Int      @default(50)
  issuedAt    DateTime @default(now())
  expiresAt   DateTime
  status      String   @default("active") // active, expired, suspended
  createdAt   DateTime @default(now())
}

// ============================================
// USERS & AUTHENTICATION
// ============================================

model User {
  id            String   @id @default(cuid())
  username      String   @unique
  email         String   @unique
  password      String
  role          String   // admin, teacher, student, parent, accountant, librarian
  status        String   @default("active") // active, inactive, suspended, pending
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id])
  profilePhoto  String?
  phone         String?
  lastLogin     DateTime?
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret String?
  emailVerified Boolean @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  student       Student?
  teacher       Teacher?
  parent        Parent?
  notifications Notification[]
  messagesSent  Message[]  @relation("SentMessages")
  messagesReceived Message[] @relation("ReceivedMessages")
  activityLogs  ActivityLog[]
  sessions      Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  expiresAt DateTime
  deviceInfo String?
  ipAddress String?
  createdAt DateTime @default(now())
}

// ============================================
// STUDENTS
// ============================================

model Student {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  studentId       String   @unique // STU0001
  fullName        String
  gender          String   // Male, Female
  dateOfBirth     DateTime?
  phone           String?
  address         String?
  
  // Academic Info
  systemType      String   @default("tvet") // tvet, reb
  trade           String   @default("") // TVET trade; empty for REB
  combination     String   @default("") // REB combination e.g. MPC; empty for TVET
  level           String   // TVET: L3/L4/L5  REB: S1/S2/S3/S4/S5/S6
  section         String   // A, B, C
  classId         String?
  class           Class?   @relation(fields: [classId], references: [id])
  enrollmentDate  DateTime @default(now())
  
  // Guardian Info
  guardianName    String?
  guardianPhone   String?
  guardianEmail   String?
  guardianRelation String?
  
  // Financial Info
  feePaid         Float    @default(0)
  feeBalance      Float    @default(0)
  
  // Status
  profilePhoto    String?
  status          String   @default("active") // active, inactive, graduated, suspended
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  marks           Mark[]
  attendance      Attendance[]
  homeworkSubmissions HomeworkSubmission[]
  examResults     ExamResult[]
  payments        Payment[]
  parentStudents  ParentStudent[]
  bookIssues      BookIssue[]
  roomAllocation  RoomAllocation?
  transportAssignment TransportAssignment?
  reportCards     ReportCard[]
}

// ============================================
// TEACHERS
// ============================================

model Teacher {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  teacherId       String   @unique // TCH0001
  fullName        String
  gender          String
  dateOfBirth     DateTime?
  phone           String?
  address         String?
  
  // Professional Info
  subjects        String   // Comma-separated or primary subject
  department      String?
  qualification   String?
  experience      String?
  joinDate        DateTime @default(now())
  salary          Float    @default(0)
  
  // Status
  profilePhoto    String?
  status          String   @default("active") // active, inactive, resigned
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  classes         Class[]
  subjectTeaching Subject[]
  marksEntered    Mark[]
  attendanceMarked Attendance[]
  homeworkAssigned Homework[]
  lessonPlans     LessonPlan[]
  payroll         Payroll[]
}

// ============================================
// PARENTS
// ============================================

model Parent {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id])
  fullName    String
  phone       String
  email       String?
  address     String?
  occupation  String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  parentStudents ParentStudent[]
}

model ParentStudent {
  id        String   @id @default(cuid())
  parentId  String
  parent    Parent   @relation(fields: [parentId], references: [id])
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  relation  String   // father, mother, guardian
  
  createdAt DateTime @default(now())
  
  @@unique([parentId, studentId])
}

// ============================================
// CLASSES & SUBJECTS
// ============================================

model Class {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id])
  name        String   // e.g., "Software Development L4 A" or "S4 MPC A"
  systemType  String   @default("tvet") // tvet, reb
  trade       String   @default("") // TVET: trade name; REB: "" 
  combination String   @default("") // REB: e.g. MPC, PCB; TVET: ""
  level       String   // TVET: L3/L4/L5  REB: S1/S2/S3/S4/S5/S6
  section     String   // A, B, C
  teacherId   String?
  teacher     Teacher? @relation(fields: [teacherId], references: [id])
  academicYear String?
  status      String   @default("active") // active, inactive
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  students    Student[]
  subjects    Subject[]
  attendance  Attendance[]
  homework    Homework[]
  exams       Exam[]
  schedules   Schedule[]
  
  @@unique([schoolId, trade, level, section])
}

model Subject {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id])
  name        String
  code        String?
  classId     String?
  class       Class?   @relation(fields: [classId], references: [id])
  teacherId   String?
  teacher     Teacher? @relation(fields: [teacherId], references: [id])
  status      String   @default("active") // active, inactive
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  marks       Mark[]
  homework    Homework[]
  exams       Exam[]
  lessonPlans LessonPlan[]
  syllabus    Syllabus?
}

// ============================================
// ACADEMIC - MARKS & ATTENDANCE
// ============================================

model Mark {
  id            String   @id @default(cuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id])
  subjectId     String
  subject       Subject  @relation(fields: [subjectId], references: [id])
  teacherId     String?
  teacher       Teacher? @relation(fields: [teacherId], references: [id])
  
  marks         Float
  grade         String?
  term          String   // Term 1, Term 2, Term 3
  academicYear  String
  examType      String   @default("Test") // Test, Exam, CAT
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Attendance {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  classId     String?
  class       Class?   @relation(fields: [classId], references: [id])
  markedBy    String?
  teacher     Teacher? @relation(fields: [markedBy], references: [id])
  
  date        DateTime
  status      String   // present, absent, late, excused
  remarks     String?
  
  createdAt   DateTime @default(now())
  
  @@unique([studentId, date])
}

model Exam {
  id            String   @id @default(cuid())
  schoolId      String?
  classId       String
  class         Class    @relation(fields: [classId], references: [id])
  subjectId     String
  subject       Subject  @relation(fields: [subjectId], references: [id])
  
  name          String
  date          DateTime
  startTime     String?
  endTime       String?
  totalMarks    Float    @default(100)
  passingMarks  Float?
  examType      String   @default("Mid Term") // Mid Term, Final, CAT
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  results       ExamResult[]
}

model ExamResult {
  id            String   @id @default(cuid())
  examId        String
  exam          Exam     @relation(fields: [examId], references: [id])
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id])
  
  marksObtained Float
  grade         String?
  remarks       String?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@unique([examId, studentId])
}

// ============================================
// HOMEWORK & LESSON PLANS
// ============================================

model Homework {
  id          String   @id @default(cuid())
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id])
  classId     String
  class       Class    @relation(fields: [classId], references: [id])
  teacherId   String
  teacher     Teacher  @relation(fields: [teacherId], references: [id])
  
  title       String
  description String
  fileUrl     String?
  dueDate     DateTime
  maxMarks    Float?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  submissions HomeworkSubmission[]
}

model HomeworkSubmission {
  id          String   @id @default(cuid())
  homeworkId  String
  homework    Homework @relation(fields: [homeworkId], references: [id])
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  
  fileUrl     String?
  content     String?  // Text submission
  submittedAt DateTime @default(now())
  marks       Float?
  feedback    String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([homeworkId, studentId])
}

model LessonPlan {
  id          String   @id @default(cuid())
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id])
  teacherId   String
  teacher     Teacher  @relation(fields: [teacherId], references: [id])
  
  title       String
  objectives  String?
  content     String
  resources   String?
  date        DateTime
  duration    Int?     // minutes
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Syllabus {
  id          String   @id @default(cuid())
  subjectId   String   @unique
  subject     Subject  @relation(fields: [subjectId], references: [id])
  
  content     String?
  fileUrl     String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Schedule {
  id          String   @id @default(cuid())
  classId     String
  class       Class    @relation(fields: [classId], references: [id])
  
  dayOfWeek   Int      // 0-6 (Sunday-Saturday)
  startTime   String
  endTime     String
  subjectName String
  teacherName String?
  room        String?
  
  createdAt   DateTime @default(now())
}

// ============================================
// REPORT CARDS
// ============================================

model ReportCard {
  id            String   @id @default(cuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id])
  
  term          String
  academicYear  String
  pdfUrl        String?
  
  totalMarks    Float?
  averageMarks  Float?
  grade         String?
  rank          Int?
  
  teacherRemarks String?
  principalRemarks String?
  
  generatedAt   DateTime @default(now())
  
  @@unique([studentId, term, academicYear])
}

// ============================================
// FINANCIAL - FEES & PAYMENTS
// ============================================

model FeeStructure {
  id            String   @id @default(cuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id])
  
  name          String   // Tuition, Lab, Library, etc.
  amount        Float
  classId       String?
  trade         String?
  level         String?
  term          String?
  academicYear  String
  dueDate       DateTime?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Payment {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id])
  
  amount          Float
  paymentMethod   String   // Cash, Bank, Mobile Money, Card
  transactionId   String?
  receiptNumber   String   @unique
  paidFor         String   // Tuition, Lab Fee, etc.
  term            String?
  academicYear    String?
  
  receivedBy      String?
  notes           String?
  
  paidAt          DateTime @default(now())
  createdAt       DateTime @default(now())
}

model Expense {
  id            String   @id @default(cuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id])
  
  category      String   // Salary, Utilities, Supplies, etc.
  amount        Float
  description   String?
  receiptUrl    String?
  paidTo        String?
  
  date          DateTime @default(now())
  createdAt     DateTime @default(now())
}

model Payroll {
  id            String   @id @default(cuid())
  teacherId     String
  teacher       Teacher  @relation(fields: [teacherId], references: [id])
  
  amount        Float
  month         Int
  year          Int
  status        String   @default("pending") // pending, paid
  bonuses       Float    @default(0)
  deductions    Float    @default(0)
  
  paidAt        DateTime?
  createdAt     DateTime @default(now())
  
  @@unique([teacherId, month, year])
}

// ============================================
// COMMUNICATION
// ============================================

model Announcement {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id])
  
  title       String
  content     String
  audience    String   // all, students, teachers, parents
  priority    String   @default("normal") // urgent, high, normal
  imageUrl    String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Event {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id])
  
  title       String
  description String?
  date        DateTime
  endDate     DateTime?
  time        String?
  location    String?
  eventType   String?  // Meeting, Holiday, Exam, Activity
  status      String   @default("scheduled") // scheduled, ongoing, completed, cancelled
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  
  title       String
  message     String
  type        String   // info, warning, success, error
  link        String?
  read        Boolean  @default(false)
  
  createdAt   DateTime @default(now())
}

model Message {
  id          String   @id @default(cuid())
  senderId    String
  sender      User     @relation("SentMessages", fields: [senderId], references: [id])
  receiverId  String
  receiver    User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  
  subject     String?
  content     String
  read        Boolean  @default(false)
  
  createdAt   DateTime @default(now())
}

// ============================================
// LIBRARY
// ============================================

model Book {
  id            String   @id @default(cuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id])
  
  title         String
  author        String?
  isbn          String?
  category      String?
  publisher     String?
  publishedYear Int?
  
  quantity      Int      @default(1)
  available     Int      @default(1)
  location      String?  // Shelf/Section
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  issues        BookIssue[]
}

model BookIssue {
  id          String   @id @default(cuid())
  bookId      String
  book        Book     @relation(fields: [bookId], references: [id])
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  
  issuedAt    DateTime @default(now())
  dueDate     DateTime
  returnedAt  DateTime?
  
  fine        Float    @default(0)
  finePaid    Boolean  @default(false)
  
  createdAt   DateTime @default(now())
}

// ============================================
// TRANSPORT
// ============================================

model Vehicle {
  id            String   @id @default(cuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id])
  
  vehicleNumber String
  driverName    String
  driverPhone   String
  capacity      Int
  vehicleType   String?  // Bus, Van, etc.
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  routes        TransportRoute[]
}

model TransportRoute {
  id            String   @id @default(cuid())
  vehicleId     String
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id])
  
  name          String
  stops         String   // JSON array of stops
  morningTime   String?
  eveningTime   String?
  fare          Float?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  assignments   TransportAssignment[]
}

model TransportAssignment {
  id            String   @id @default(cuid())
  studentId     String   @unique
  student       Student  @relation(fields: [studentId], references: [id])
  routeId       String
  route         TransportRoute @relation(fields: [routeId], references: [id])
  
  pickupPoint   String?
  
  createdAt     DateTime @default(now())
}

// ============================================
// HOSTEL
// ============================================

model Room {
  id            String   @id @default(cuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id])
  
  roomNumber    String
  block         String?
  floor         Int?
  capacity      Int
  occupants     Int      @default(0)
  gender        String?  // Male, Female
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  allocations   RoomAllocation[]
}

model RoomAllocation {
  id            String   @id @default(cuid())
  studentId     String   @unique
  student       Student  @relation(fields: [studentId], references: [id])
  roomId        String
  room          Room     @relation(fields: [roomId], references: [id])
  
  bedNumber     String?
  allocatedAt   DateTime @default(now())
  vacatedAt     DateTime?
  
  createdAt     DateTime @default(now())
}

// ============================================
// SYSTEM & SETTINGS
// ============================================

model Setting {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id])
  
  key         String
  value       String
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([schoolId, key])
}

model ActivityLog {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id])
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  
  action      String
  details     String?
  ipAddress   String?
  
  createdAt   DateTime @default(now())
}
