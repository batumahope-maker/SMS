# ESSJT environment configuration — EXAMPLE ONLY.
#
# Copy the entries you need into `.env.local` (which is user-owned and never
# tracked). Never put real credentials in this file or in any tracked file.

# --- NextAuth -----------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with: openssl rand -base64 32

# --- Read-only application database -------------------------------------------
# The application read path uses a strictly SELECT-only account.
DATABASE_URL=mysql://<readonly-user>:<password>@127.0.0.1:3306/essjt_school_system

# --- Restricted writer account (registration / approval / password flows) -----
# Used only by src/lib/db-writer.ts. The account must hold exactly:
#   GRANT USAGE ON *.* TO '<writer>'@'localhost';
#   GRANT EXECUTE ON PROCEDURE essjt_school_system.sp_register_student TO ...
#   (EXECUTE on all six procedures; NO table privileges of any kind)
#
# The URL MUST have an EMPTY default database (trailing "/") — the writer has
# no db-level privileges, so selecting a default database fails with 1044.
# connection_limit=1 is appended automatically by db-writer.ts.
WRITER_DATABASE_URL=mysql://<writer-user>:<password>@127.0.0.1:3306/
# Database the writer CALLs are qualified against (default: essjt_school_system)
WRITER_DATABASE_NAME=essjt_school_system

# --- Registration rate limiting (optional) ------------------------------------
# In-memory, per-IP. Defaults to 10 submissions per hour per IP.
# REGISTRATION_RATE_LIMIT_MAX (number, default 10)
# REGISTRATION_RATE_LIMIT_WINDOW_MINUTES (number, default 60)
