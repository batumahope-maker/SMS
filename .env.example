# ============================================================
# ESSJT School Management System - Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ── Authentication ──────────────────────────────────────────
# Generate a secure secret: openssl rand -base64 64
NEXTAUTH_SECRET=your-super-secret-key-minimum-32-characters-change-this-in-production

# Your app's URL (no trailing slash)
# Development:
NEXTAUTH_URL=http://localhost:3000
# Production (example):
# NEXTAUTH_URL=https://yourschool.essjt.rw

# ── Database ─────────────────────────────────────────────────
# Development (SQLite - already configured in schema.prisma):
DATABASE_URL="file:./dev.db"

# Production (PostgreSQL - switch schema.prisma provider to postgresql):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/essjt_db?schema=public"

# Railway PostgreSQL example:
# DATABASE_URL="postgresql://postgres:xxxx@containers-us-west-1.railway.app:6234/railway"

# Supabase example:
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres"

# ── Optional: SMS Notifications (Africa's Talking) ──────────
# Sign up at africastalking.com - works for Rwanda (+250)
# AT_USERNAME=your_username
# AT_API_KEY=your_api_key
# AT_SENDER_ID=ESSJT

# ── Optional: Email (SMTP for password reset emails) ────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM=ESSJT SMS <noreply@essjt.rw>

# ── Optional: File uploads (Cloudinary for profile photos) ──
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# ── App Config ───────────────────────────────────────────────
NODE_ENV=development
# NODE_ENV=production
